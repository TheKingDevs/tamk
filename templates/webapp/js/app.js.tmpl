 * Versão: {{VERSION}}
 */

(function() {
  'use strict';

  // Inicialização do App
  console.log('[{{NAME}}] App inicializado');
  console.log('[{{NAME}}] Versão: {{VERSION}}');

  // Detecta se está em modo desenvolvimento
  const isDevMode = window.location.hostname === 'localhost' || 
                    window.location.hostname === '127.0.0.1';

  if (isDevMode) {
    console.log('[{{NAME}}] Modo desenvolvimento detectado');
  }

  // Funções utilitárias globais
  window.App = {
    name: '{{NAME}}',
    version: '{{VERSION}}',
    author: '{{AUTHOR}}',

    /**
     * Exibe informações do app no console
     */
    info: function() {
      console.group('📱 {{NAME}}');
      console.log('Versão: {{VERSION}}');
      console.log('Autor: {{AUTHOR}}');
      console.log('Package: {{PACKAGE}}');
      console.log('Desenvolvido com T.A.M.K v{{TAMK_VERSION}}');
      console.groupEnd();
    },

    /**
     * Navega para uma URL interna
     * @param {string} path - Caminho relativo
     */
    navigate: function(path) {
      console.log('[Navigation]', path);
      // Implementar navegação customizada se necessário
    },

    /**
     * Carrega dados de forma assíncrona
     * @param {string} url - URL para fetch
     * @returns {Promise<any>}
     */
    fetch: async function(url) {
      try {
        const response = await window.fetch(url);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return await response.json();
      } catch (error) {
        console.error('[Fetch Error]', error);
        throw error;
      }
    }
  };

  // Auto-executa informações no console
  window.App.info();

})();
