package {{PACKAGE}}.security

import android.content.Context
import android.content.pm.PackageManager
import android.os.Build
import java.io.File
import java.security.MessageDigest

/**
 * IntegrityVerifier — Verify app integrity at runtime
 * Detects tampering, repackaging, and modification.
 */
object IntegrityVerifier {

    // Expected hash of the DEX file (computed at build time)
    private var expectedDexHash: String = ""
    
    // Expected hash of the APK signature
    private var expectedSignatureHash: String = ""
    
    // Salt for hash computation
    private const val HASH_SALT = "TAMK_INTEGRITY_SALT_2024"

    /**
     * Initialize with expected hashes.
     * @param dexHash Expected SHA-256 hash of DEX
     * @param signatureHash Expected SHA-256 hash of APK signature
     */
    fun initialize(dexHash: String = "", signatureHash: String = "") {
        expectedDexHash = dexHash
        expectedSignatureHash = signatureHash
    }

    /**
     * Verify the integrity of the DEX file.
     * @return true if DEX is intact
     */
    fun verifyDexIntegrity(context: Context): Boolean {
        if (expectedDexHash.isEmpty()) return true // No hash to verify against
        
        try {
            val dexPath = context.applicationInfo.sourceDir
            val actualHash = computeFileHash(dexPath)
            return actualHash == expectedDexHash
        } catch (e: Exception) {
            return false
        }
    }

    /**
     * Verify the APK signature.
     * @return true if signature matches expected hash
     */
    fun verifySignature(context: Context): Boolean {
        if (expectedSignatureHash.isEmpty()) return true // No hash to verify against
        
        try {
            val packageInfo = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                context.packageManager.getPackageInfo(
                    context.packageName,
                    PackageManager.GET_SIGNING_CERTIFICATES
                )
            } else {
                @Suppress("DEPRECATION")
                context.packageManager.getPackageInfo(
                    context.packageName,
                    PackageManager.GET_SIGNATURES
                )
            }

            val signatures = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                packageInfo.signingInfo.apkContentsSigners
            } else {
                @Suppress("DEPRECATION")
                packageInfo.signatures
            }

            for (signature in signatures) {
                val digest = MessageDigest.getInstance("SHA-256")
                val hash = digest.digest(signature.toByteArray())
                    .joinToString("") { "%02x".format(it) }
                
                if (hash == expectedSignatureHash) {
                    return true
                }
            }
        } catch (e: Exception) {
            // Verification failed
        }
        
        return false
    }

    /**
     * Verify app is not running on a rooted device.
     * @return true if device is not rooted
     */
    fun verifyNotRooted(): Boolean {
        // Additional root checks beyond GuardianBridge
        val rootIndicators = listOf(
            "/system/app/Superuser.apk",
            "/system/xbin/su",
            "/system/bin/su"
        )
        
        for (path in rootIndicators) {
            if (File(path).exists()) return false
        }
        
        return true
    }

    /**
     * Verify app is not being debugged.
     * @return true if not debugging
     */
    fun verifyNotDebugged(): Boolean {
        return !android.os.Debug.isDebuggerConnected()
    }

    /**
     * Perform full integrity verification.
     * @return IntegrityResult with all checks
     */
    fun verifyAll(context: Context): IntegrityResult {
        return IntegrityResult(
            dexIntegrity = verifyDexIntegrity(context),
            signatureValid = verifySignature(context),
            notRooted = verifyNotRooted(),
            notDebugged = verifyNotDebugged(),
            packageName = context.packageName,
            versionCode = getVersionCode(context)
        )
    }

    /**
     * Compute SHA-256 hash of a file.
     */
    private fun computeFileHash(filePath: String): String {
        val digest = MessageDigest.getInstance("SHA-256")
        File(filePath).inputStream().use { input ->
            val buffer = ByteArray(8192)
            var read: Int
            while (input.read(buffer).also { read = it } != -1) {
                digest.update(buffer, 0, read)
            }
        }
        return digest.digest().joinToString("") { "%02x".format(it) }
    }

    /**
     * Get version code from package info.
     */
    private fun getVersionCode(context: Context): Long {
        return try {
            val packageInfo = context.packageManager.getPackageInfo(context.packageName, 0)
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                packageInfo.longVersionCode
            } else {
                @Suppress("DEPRECATION")
                packageInfo.versionCode.toLong()
            }
        } catch (e: Exception) {
            -1
        }
    }

    /**
     * Result of integrity verification.
     */
    data class IntegrityResult(
        val dexIntegrity: Boolean,
        val signatureValid: Boolean,
        val notRooted: Boolean,
        val notDebugged: Boolean,
        val packageName: String,
        val versionCode: Long
    ) {
        val isSecure: Boolean
            get() = dexIntegrity && signatureValid && notRooted && notDebugged
        
        override fun toString(): String {
            return buildString {
                appendLine("=== Integrity Verification ===")
                appendLine("DEX Integrity: ${if (dexIntegrity) "✅ PASS" else "❌ FAIL"}")
                appendLine("Signature: ${if (signatureValid) "✅ PASS" else "❌ FAIL"}")
                appendLine("Not Rooted: ${if (notRooted) "✅ PASS" else "❌ FAIL"}")
                appendLine("Not Debugged: ${if (notDebugged) "✅ PASS" else "❌ FAIL"}")
                appendLine("Package: $packageName")
                appendLine("Version: $versionCode")
                appendLine("Overall: ${if (isSecure) "✅ SECURE" else "❌ COMPROMISED"}")
            }
        }
    }
}
