package {{PACKAGE}}

import android.app.Activity
import android.graphics.Color
import android.graphics.Typeface
import android.os.Bundle
import android.view.Gravity
import android.view.View
import android.view.ViewGroup
import android.widget.Button
import android.widget.LinearLayout
import android.widget.TextView
import android.widget.Toast

class MainActivity : Activity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT
            )
            gravity = Gravity.CENTER
            setPadding(64, 0, 64, 0)
            setBackgroundColor(Color.parseColor("#1A1A2E"))
        }

        root.addView(TextView(this).apply {
            text = "{{NAME}}"
            textSize = 32f
            setTextColor(Color.WHITE)
            typeface = Typeface.DEFAULT_BOLD
            gravity = Gravity.CENTER
        })

        root.addView(TextView(this).apply {
            text = "v{{VERSION}}"
            textSize = 14f
            setTextColor(Color.parseColor("#B0B0B0"))
            gravity = Gravity.CENTER
        })

        root.addView(createSpacer(120))

        root.addView(Button(this).apply {
            text = "INICIAR PROJETO"
            setTextColor(Color.WHITE)
            setBackgroundColor(Color.parseColor("#6200EE"))
            textSize = 16f
            typeface = Typeface.DEFAULT_BOLD
            layoutParams = LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                140
            )
            setOnClickListener {
                Toast.makeText(this@MainActivity,
                    "T.A.M.K Factory: Ambiente Pronto!", Toast.LENGTH_SHORT).show()
            }
        })

        root.addView(createSpacer(48))

        root.addView(TextView(this).apply {
            text = "Desenvolvido por {{AUTHOR}}"
            textSize = 12f
            setTextColor(Color.parseColor("#888888"))
            gravity = Gravity.CENTER
        })

        setContentView(root)
    }

    private fun createSpacer(heightDp: Int): View {
        return View(this).apply {
            layoutParams = LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, heightDp
            )
        }
    }
}
