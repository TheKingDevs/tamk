/**
 * T.A.M.K Dev Bridge - HMR Client com State Preservation
 * Versão: {{VERSION}}
 *
 * Suporta:
 * - CSS Hot Reload (sem reload)
 * - JavaScript HMR com module registry
 * - State preservation entre updates
 * - Error recovery com fallback para full reload
 */

(function() {
    'use strict';

    // Previne múltiplas inicializações
    if (window.TAMK_DEV && window.TAMK_DEV.initialized) {
        return;
    }

    window.TAMK_DEV = {
        version: '{{VERSION}}',
        ws: null,
        reconnectAttempts: 0,
        maxReconnectAttempts: 10,
        reconnectInterval: 1000,
        initialized: false,
        heartbeatInterval: null,
        
        // HMR State Management
        hmr: {
            enabled: true,
            moduleId: 0,
            modules: {}, // Registry de módulos carregados
            acceptHandlers: {}, // Handlers por tipo de arquivo
            stateStore: {}, // Estado preservado entre HMR updates
            lastTimestamp: 0,
            pendingUpdates: [],
            
            // Registra um módulo no sistema HMR
            register: function(modulePath, moduleExports) {
                this.modules[modulePath] = {
                    path: modulePath,
                    exports: moduleExports,
                    timestamp: Date.now(),
                    id: ++this.moduleId
                };
                console.log('[TAMK HMR] Módulo registrado:', modulePath);
                return this.modules[modulePath];
            },
            
            // Aceita update de módulo específico
            accept: function(modulePath, callback) {
                if (typeof modulePath === 'function') {
                    callback = modulePath;
                    modulePath = '*';
                }
                this.acceptHandlers[modulePath] = callback;
                console.log('[TAMK HMR] Handler accept registrado para:', modulePath);
            },
            
            // Salva estado para recuperação após HMR
            saveState: function(key, value) {
                this.stateStore[key] = value;
                console.log('[TAMK HMR] Estado salvo:', key);
            },
            
            // Recupera estado após HMR
            getState: function(key) {
                return this.stateStore[key];
            },
            
            // Limpa estado de um módulo
            dispose: function(modulePath) {
                if (this.acceptHandlers[modulePath]) {
                    delete this.acceptHandlers[modulePath];
                }
                if (this.modules[modulePath]) {
                    delete this.modules[modulePath];
                }
            }
        },

        init: function() {
            if (this.initialized) return;
            this.initialized = true;

            console.log('[TAMK] Dev Bridge HMR v' + this.version);
            console.log('[TAMK] HMR Enabled:', this.hmr.enabled);
            
            this.connect();

            this.heartbeatInterval = setInterval(() => {
                if (this.ws && this.ws.readyState === WebSocket.OPEN) {
                    this.ws.send(JSON.stringify({
                        type: 'ping', 
                        timestamp: Date.now(),
                        modulesLoaded: Object.keys(this.hmr.modules).length
                    }));
                }
            }, 30000); // 30s
        },

        connect: function() {
            var self = this;
            var wsUrl = 'ws://localhost:{{DEV_PORT}}';

            try {
                this.ws = new WebSocket(wsUrl);

                this.ws.onopen = function() {
                    console.log('[TAMK] Conectado ao dev server');
                    self.reconnectAttempts = 0;
                    self.ws.send(JSON.stringify({
                        type: 'hello',
                        version: self.version,
                        url: window.location.href,
                        hmrEnabled: self.hmr.enabled,
                        loadedModules: Object.keys(self.hmr.modules),
                        scrollPosition: window.scrollY
                    }));
                };

                this.ws.onmessage = function(event) {
                    try {
                        var data = JSON.parse(event.data);
                        self.handleMessage(data);
                    } catch(e) {
                        console.error('[TAMK] Erro ao processar mensagem:', e);
                    }
                };

                this.ws.onclose = function(event) {
                    console.log('[TAMK] Desconectado (código: ' + event.code + ')');
                    self.attemptReconnect();
                };

                this.ws.onerror = function(error) {
                    console.error('[TAMK] Erro de conexão:', error);
                };

            } catch(e) {
                console.error('[TAMK] Falha ao criar WebSocket:', e);
                this.attemptReconnect();
            }
        },

        attemptReconnect: function() {
            if (this.reconnectAttempts >= this.maxReconnectAttempts) {
                console.log('[TAMK] Máximo de tentativas de reconexão atingido');
                return;
            }

            this.reconnectAttempts++;
            var delay = this.reconnectInterval * Math.pow(2, this.reconnectAttempts - 1);
            delay = Math.min(delay, 30000); // Máximo 30s

            console.log('[TAMK] Reconectando em ' + (delay/1000) + 's (tentativa ' + this.reconnectAttempts + ')');

            setTimeout(() => {
                this.connect();
            }, delay);
        },

        handleMessage: function(data) {
            switch(data.type) {
                case 'reload':
                    console.log('[TAMK] Full reload solicitado');
                    this.performFullReload();
                    break;

                case 'css-update':
                    console.log('[TAMK] CSS update recebido');
                    this.reloadCSS(data.files);
                    break;

                case 'js-hmr':
                    console.log('[TAMK] JavaScript HMR update recebido');
                    this.handleJavaScriptHMR(data);
                    break;

                case 'json-update':
                    console.log('[TAMK] JSON update recebido');
                    this.handleJSONUpdate(data);
                    break;

                case 'error':
                    console.error('[TAMK] Erro do servidor:', data.message);
                    if (data.fatal) {
                        this.performFullReload();
                    }
                    break;

                case 'pong':
                    break;

                default:
                    console.log('[TAMK] Mensagem desconhecida:', data);
            }
        },

        // === Full Reload com State Preservation ===
        performFullReload: function() {
            // Salva estado global antes do reload
            this.hmr.saveState('scrollPosition', window.scrollY);
            this.hmr.saveState('formData', this.captureFormData());
            this.hmr.saveState('timestamp', Date.now());

            console.log('[TAMK] Recarregando página com state preservation...');
            
            // Pequeno delay para garantir que estado foi salvo
            setTimeout(() => {
                window.location.reload();
            }, 100);
        },

        captureFormData: function() {
            var formData = {};
            var inputs = document.querySelectorAll('input, textarea, select');
            inputs.forEach(function(input, index) {
                var id = input.id || 'input_' + index;
                if (input.type === 'checkbox' || input.type === 'radio') {
                    formData[id] = input.checked;
                } else {
                    formData[id] = input.value;
                }
            });
            return formData;
        },

        restoreFormData: function(formData) {
            if (!formData) return;
            
            for (var id in formData) {
                var input = document.getElementById(id) || 
                           document.querySelector('input[data-index="' + id + '"]');
                if (input) {
                    if (input.type === 'checkbox' || input.type === 'radio') {
                        input.checked = formData[id];
                    } else {
                        input.value = formData[id];
                    }
                }
            }
        },

        restoreState: function() {
            // Restaura scroll position
            var scrollPos = this.hmr.getState('scrollPosition');
            if (scrollPos !== undefined) {
                setTimeout(() => {
                    window.scrollTo(0, parseInt(scrollPos) || 0);
                }, 100);
            }

            // Restaura form data após DOM estar pronto
            var formData = this.hmr.getState('formData');
            if (formData) {
                setTimeout(() => {
                    this.restoreFormData(formData);
                }, 200);
            }
        },

        // === CSS Hot Reload ===
        reloadCSS: function(files) {
            var links = document.querySelectorAll('link[rel="stylesheet"]');
            var updated = 0;

            links.forEach((function(link) {
                var href = link.href;
                var shouldUpdate = !files || files.length === 0 || 
                                   files.some(function(f) { return href.indexOf(f) !== -1; });
                
                if (shouldUpdate) {
                    var url = new URL(href);
                    url.searchParams.set('_tamk', Date.now());
                    link.href = url.toString();
                    updated++;
                }
            }).bind(this));

            console.log('[TAMK] CSS atualizado (' + updated + ' arquivos)');
            this.restoreState();
        },

        // === JavaScript HMR ===
        handleJavaScriptHMR: function(data) {
            var self = this;
            var modules = data.modules || [];
            var timestamp = data.timestamp || Date.now();

            if (timestamp <= this.hmr.lastTimestamp) {
                console.log('[TAMK HMR] Update antigo, ignorando');
                return;
            }

            console.log('[TAMK HMR] Processando ' + modules.length + ' módulo(s)...');

            // Salva estado antes de aplicar updates
            var savedState = {
                scroll: window.scrollY,
                selection: this.saveSelection(),
                activeElement: document.activeElement ? document.activeElement.id : null
            };

            var needsReload = false;
            var appliedModules = [];

            modules.forEach(function(mod) {
                var path = mod.path || mod.file;
                var content = mod.content;
                var error = mod.error;

                if (error) {
                    console.error('[TAMK HMR] Erro no módulo ' + path + ':', error);
                    needsReload = true;
                    return;
                }

                // Verifica se há handler accept para este módulo
                var handler = self.hmr.acceptHandlers[path] || 
                             self.hmr.acceptHandlers['*'] ||
                             self.hmr.acceptHandlers['*.js'];

                if (handler) {
                    try {
                        // Executa handler de HMR
                        var result = handler({
                            modulePath: path,
                            newContent: content,
                            timestamp: timestamp,
                            TAMK: self
                        });

                        if (result === false) {
                            // Handler recusou o update
                            console.log('[TAMK HMR] Handler recusou update para:', path);
                            needsReload = true;
                        } else {
                            appliedModules.push(path);
                            console.log('[TAMK HMR] Módulo aplicado:', path);
                        }
                    } catch(e) {
                        console.error('[TAMK HMR] Erro no handler:', e);
                        needsReload = true;
                    }
                } else {
                    // Sem handler - eval direto (modo simples)
                    try {
                        // Remove script tags existentes deste módulo
                        var oldScripts = document.querySelectorAll('script[data-hmr-path="' + path + '"]');
                        oldScripts.forEach(function(s) { s.remove(); });

                        // Cria novo script
                        var script = document.createElement('script');
                        script.textContent = content;
                        script.setAttribute('data-hmr-path', path);
                        script.setAttribute('data-hmr-time', timestamp);
                        document.head.appendChild(script);

                        appliedModules.push(path);
                        console.log('[TAMK HMR] Módulo injetado:', path);

                    } catch(e) {
                        console.error('[TAMK HMR] Falha ao injetar módulo:', path, e);
                        needsReload = true;
                    }
                }
            });

            if (needsReload) {
                console.log('[TAMK HMR] Fallback para full reload');
                this.performFullReload();
            } else {
                this.hmr.lastTimestamp = timestamp;
                console.log('[TAMK HMR] Update aplicado com sucesso (' + appliedModules.length + ' módulos)');
                
                // Restaura estado
                setTimeout(function() {
                    if (savedState.scroll) {
                        window.scrollTo(0, savedState.scroll);
                    }
                    if (savedState.activeElement) {
                        var el = document.getElementById(savedState.activeElement);
                        if (el && el.focus) el.focus();
                    }
                }, 50);
            }
        },

        saveSelection: function() {
            if (window.getSelection) {
                var sel = window.getSelection();
                if (sel.getRangeAt && sel.rangeCount) {
                    return sel.getRangeAt(0);
                }
            }
            return null;
        },

        // === JSON Update ===
        handleJSONUpdate: function(data) {
            var path = data.file;
            var content = data.content;

            // Notifica listeners
            var handler = this.hmr.acceptHandlers[path] || 
                         this.hmr.acceptHandlers['*.json'];
            
            if (handler) {
                try {
                    handler({
                        modulePath: path,
                        newContent: JSON.parse(content),
                        rawContent: content,
                        TAMK: this
                    });
                    console.log('[TAMK HMR] JSON atualizado:', path);
                } catch(e) {
                    console.error('[TAMK HMR] Erro ao processar JSON:', e);
                }
            }
        },

        // === API Pública ===
        
        // Recarrega página manualmente
        reload: function() {
            if (this.ws && this.ws.readyState === WebSocket.OPEN) {
                this.ws.send(JSON.stringify({type: 'request-reload'}));
            } else {
                window.location.reload();
            }
        },

        // Envia mensagem customizada para o servidor
        send: function(type, data) {
            if (this.ws && this.ws.readyState === WebSocket.OPEN) {
                this.ws.send(JSON.stringify(Object.assign({type: type}, data)));
            }
        },

        // Habilita/desabilita HMR
        setHMREnabled: function(enabled) {
            this.hmr.enabled = enabled;
            console.log('[TAMK HMR] HMR ' + (enabled ? 'habilitado' : 'desabilitado'));
        },

        // Lista módulos registrados
        listModules: function() {
            return Object.keys(this.hmr.modules);
        }
    };

    // Auto-inicialização
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            window.TAMK_DEV.init();
        });
    } else {
        window.TAMK_DEV.init();
    }

    // Cleanup ao sair da página
    window.addEventListener('beforeunload', function() {
        if (window.TAMK_DEV.heartbeatInterval) {
            clearInterval(window.TAMK_DEV.heartbeatInterval);
        }
        if (window.TAMK_DEV.ws) {
            window.TAMK_DEV.ws.close();
        }
    });

    // Expor API globalmente para uso em consoles/dev tools
    window.TAMK_HMR = window.TAMK_DEV.hmr;

})();
